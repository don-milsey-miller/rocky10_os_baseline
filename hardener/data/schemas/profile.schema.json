{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "target",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "major_version",
        "role"
      ],
      "properties": {
        "os": {
          "const": "rocky"
        },
        "major_version": {
          "type": "integer",
          "const": 10
        },
        "role": {
          "const": "server"
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "enabled": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
